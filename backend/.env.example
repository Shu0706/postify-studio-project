NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/postify-studio
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
FRONTEND_URL=http://localhost:5173

# Bootstrap Admin (used by scripts)
ADMIN_EMAIL=admin@postifystudio.com
ADMIN_PASSWORD=admin123456

# Optional Email (enable if sending emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@postifystudio.com

# Optional Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI
OPENAI_API_KEY=your-openai-api-key-here

# File Upload Settings
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
BASE_URL=http://localhost:5000

# Optional Internal API key guard
API_KEY=# Environment Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/postify-studio
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/postify-studio

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@postifystudio.com

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Cloudinary Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin Default Credentials
ADMIN_EMAIL=admin@postifystudio.com
ADMIN_PASSWORD=admin123456

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
